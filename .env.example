# Threads：公開個人頁爬取（無需 token）
# 逗號分隔 username。預設 zuck,meta,threads（資料中心 IP 較穩定）
# 許多台灣帳號從此環境會回空 HTML，請用 THREADS_USERS 覆寫測試
THREADS_USERS=zuck,meta,threads

# ── Meta Graph（Facebook + Instagram）──
# 於 https://developers.facebook.com/tools/explorer/ 取得
# 建議權限：pages_show_list, pages_read_engagement, pages_read_user_content,
#           instagram_basic, instagram_manage_insights（依 App 審核狀態）
# 查詢範例：
#   GET /me/accounts?fields=id,name,access_token,instagram_business_account
# 回傳的 access_token 為 Page token；instagram_business_account.id 為 IG User ID
META_ACCESS_TOKEN=
# 或使用別名：
# FACEBOOK_ACCESS_TOKEN=

# Facebook 粉專：Page ID 或 username（逗號分隔）
# 預設嘗試 CNA.tw,ltntw,udn.com
FACEBOOK_PAGE_IDS=CNA.tw,ltntw,udn.com

# Instagram：數值型 IG 商業／創作者帳號 ID（逗號分隔）
INSTAGRAM_USER_IDS=

# 可選：Instagram Login 產物（graph.instagram.com/me/media）
# INSTAGRAM_ACCESS_TOKEN=

# 可選：自架 RSSHub 後備（勿依賴公開 rsshub.app）
# 例：http://127.0.0.1:1200 → /facebook/page/{id}、/instagram/user/{user}
# RSSHUB_BASE=http://127.0.0.1:1200
